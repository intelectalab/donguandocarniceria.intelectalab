# URL de la API de Laravel (php artisan serve --port=8010). La web la sirve bajo /api.
API_URL=http://127.0.0.1:8010

# Página pública (landing), como en erp-saas. Con las dos, la página vive en SITE_URL y el sistema en APP_URL;
# sin ellas, todo va en un solo dominio.
# SITE_URL=https://aycha.pe
# APP_URL=https://app.aycha.pe

# WhatsApp de ventas para los botones de la página (solo dígitos, con el código del país). Sin él no se muestran.
# NEXT_PUBLIC_WHATSAPP_VENTAS=51987654321

# Google Analytics de la página pública (ID de medición G-XXXXXXXXXX). Sin él no hay aviso de cookies ni código de
# Google. Con él, solo se carga si la persona acepta, y nunca en el sistema.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
